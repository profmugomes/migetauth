' Gera o código TOTP atual
Public Function TOTP(sSecret As String, Optional iDigits As Integer = 6, Optional iPeriod As Integer = 30) As String
  Dim sOutput As String
  Dim sCommand As String
  
  If Not IsValidSecret(sSecret) Then Message.Error("Segredo Base32 inválido")
  If iDigits < 6 Or iDigits > 8 Then Message.Error("Quantidade de dígitos inválida")
  If iPeriod < 1 Then Message.Error("Período inválido")
  If Not sSecret Then Message.Error("Segredo vazio")

  sCommand = "oathtool --totp --base32 --digits=" & Str(iDigits) & " --time-step-size=" & Str(iPeriod) & "s '" & sSecret & "'"

  Shell sCommand To sOutput

  Return Trim(sOutput)
End

Public Function VerifyTOTP(sSecret As String, sCode As String, Optional iWindow As Integer = 1, Optional iDigits As Integer = 6, Optional iPeriod As Integer = 30) As Boolean
  Dim i As Integer
  Dim sOutput As String
  Dim sCommand As String
  Dim iBaseTimestamp As Long
  Dim iTimestamp As Long
  
  If Not IsDigit(sCode) Then Return False
  If Len(sCode) <> iDigits Then Return False
  If iWindow < 0 Or iWindow > 10 Then Return False
  If Not sSecret Then Return False

  iBaseTimestamp = DateDiff(CDate("1/1/1970"), Now(), gb.Second)

  For i = -iWindow To iWindow
    iTimestamp = iBaseTimestamp + (i * iPeriod)
    
    ' Adicionado o '@' antes do timestamp, que indica formato Unix Epoch para o oathtool
    sCommand = "oathtool --totp --base32 --digits=" & Str(iDigits) & " --time-step-size=" & Str(iPeriod) & "s --now=@" & Str(iTimestamp) & " '" & sSecret & "' 2>&1"

    Shell sCommand To sOutput
    sOutput = Trim(sOutput)
    
    If sOutput = sCode Then Return True
  Next

  Return False
End

Private Function IsValidSecret(sSecret As String) As Boolean
  Dim i As Integer
  Dim sChar As String
  Dim sClean As String
  
  If Not sSecret Then 
    Print "Erro IsValidSecret: Segredo vazio ou nulo."
    Return False
  End If
  
  ' Remove espaços e hífens internos/externos comuns em chaves formatadas
  sClean = Replace(sSecret, " ", "")
  sClean = Replace(sClean, "-", "")
  sClean = Trim(sClean)
  
  ' Verificação de tamanho (alguns usam 16, mas se o seu for menor, ajuste aqui)
  If Len(sClean) < 8 Then 
    Print "Erro IsValidSecret: Tamanho muito curto -> " & Len(sClean)
    Return False
  End If

  For i = 1 To Len(sClean)
    sChar = UCase(Mid(sClean, i, 1))
    
    ' Valida caracteres permitidos em Base32 + Padding (=)
    If InStr("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567=", sChar) = 0 Then 
      Print "Erro IsValidSecret: Caractere inválido encontrado: [" & sChar & "]"
      Return False
    End If
  Next

  Return True
End