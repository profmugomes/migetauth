Public sID As Integer
Private $conecta As Connection

Public Sub btnAddAccount_Click()
  
  Try $conecta.Close()
  $conecta = New Connection
  $conecta.Type = "sqlite3"
  $conecta.Host = FMain.dbPath 
  $conecta.Name = FMain.dbName
  $conecta.Open()
  
  If sID = 0 Then
    $conecta.Exec("INSERT INTO accounts (name,secret) VALUES (&1,&2)", txtNomeConta.Text, encrypt(txtChaveSecreta.Text))
  Else 
    $conecta.Exec("UPDATE accounts SET name=&1 WHERE id=&2", txtNomeConta.Text, sID)
  Endif
  
  $conecta.Close()
  
  FMain.dbLoad()
  Me.Close()

End

Private Sub getAccountName()
  If sID > 0 Then 
    Try $conecta.Close()
    $conecta = New Connection
    $conecta.Type = "sqlite3"
    $conecta.Host = FMain.dbPath
    $conecta.Name = FMain.dbName
    $conecta.Open()
    
    Print sID
    
    Dim rs As Result = $conecta.Exec("SELECT id,name FROM accounts WHERE id=&1", sID)
    
    While (rs.Available)
      txtNomeConta.Text = rs!name
      
      rs.MoveNext()
    Wend
    
    $conecta.Close()
    
    txtChaveSecreta.Enabled = False
    btnQRCode.Enabled = False
  Endif
End

Public Sub Form_Open()

  getAccountName()

End

Private Function encrypt(value As String) As String
  Dim sSecret As String = FMain.getSecret()
  Return modEncrypt.setFernet(value, sSecret)
End

Public Sub btnQRCode_Click()

  txtChaveSecreta.Text = modQRCode.LerQRCode()

End
